<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(UX.ControlPlane.Pages.Shared.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(UX.ControlPlane.Pages.Shared.MainLayout)">
            <p class="m-3">Sorry, there’s nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
